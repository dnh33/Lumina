# ── Lumina configuration ────────────────────────────────────────────
# Copy this file to `.env` in the repo root and fill in your keys.

# TMDB v4 Read Access Token (free) — https://www.themoviedb.org/settings/api
# Use the long "API Read Access Token", not the short v3 key.
TMDB_ACCESS_TOKEN=

# OpenRouter API key — https://openrouter.ai/keys
# Powers the AI companion. Any chat model works; pick one below.
OPENROUTER_API_KEY=

# Model used for conversations (any OpenRouter slug).
# Great options: anthropic/claude-sonnet-5, anthropic/claude-sonnet-4.5, openai/gpt-5
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# OMDb API key — https://www.omdbapi.com/apikey.aspx (free tier: 1,000 req/day)
# Powers IMDb + Rotten Tomatoes critics scores (lazy-enriched, 30-day cache).
# Leave blank to run fully without critics data — the app skips the network.
OMDB_API_KEY=

# ── Optional ────────────────────────────────────────────────────────
# API server port (the web app proxies to this)
PORT=4000

# Set to 0.0.0.0 to reach Lumina from your phone/tablet on the same network
HOST=127.0.0.1

# Custom database location (defaults to <repo>/data/lumina.db)
# LUMINA_DB=
